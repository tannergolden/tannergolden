# Normalize line endings so a checkout on Windows does not turn a script
# into something the runner cannot execute.
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.svg  text eol=lf

*.png binary
*.jpg binary
*.gif binary
*.ico binary

# WHAT LINGUIST COUNTS, AND WHY IT IS SET BY HAND HERE.
#
# This repository is a profile page that writes itself, so most of its bytes
# are generated: dispatches, rendered badges and the cards. Left alone,
# Linguist would report the profile as whatever the generator happened to
# emit most of, which says nothing about what the account works in.
#
# The archive is documentation, the badges and cards are generated assets,
# and the fixtures are test data. What remains counted is `src/`, which is
# the only code a person here actually wrote.
dispatches/**      linguist-documentation
assets/**       linguist-generated
state/*.json    linguist-generated
